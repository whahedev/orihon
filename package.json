{
  "name": "orihon",
  "version": "1.9.0",
  "description": "A free, open-source browser map engine. Apache 2.0. Use it anywhere.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./standard": {
      "types": "./dist/standard.d.ts",
      "import": "./dist/standard.js"
    },
    "./easy": {
      "types": "./dist/easy-entry.d.ts",
      "import": "./dist/easy-entry.js"
    },
    "./source": {
      "types": "./dist/feature-source.d.ts",
      "import": "./dist/feature-source.js"
    },
    "./draw": {
      "types": "./dist/draw/index.d.ts",
      "import": "./dist/draw/index.js"
    },
    "./draw.css": "./dist/draw.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./pmtiles": {
      "types": "./dist/layers/pmtiles.d.ts",
      "import": "./dist/layers/pmtiles.js"
    },
    "./mlt": {
      "types": "./dist/layers/mlt.d.ts",
      "import": "./dist/layers/mlt.js"
    },
    "./mvt-wasm": {
      "types": "./dist/layers/mvt-wasm.d.ts",
      "import": "./dist/layers/mvt-wasm.js"
    },
    "./mvt": {
      "types": "./dist/mvt-entry.d.ts",
      "import": "./dist/mvt-entry.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu-entry.d.ts",
      "import": "./dist/webgpu-entry.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "import": "./dist/controls.js"
    },
    "./geo": {
      "types": "./dist/geo-entry.d.ts",
      "import": "./dist/geo-entry.js"
    },
    "./popup-content": {
      "types": "./dist/popup-content.d.ts",
      "import": "./dist/popup-content.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/orihon.esm.js"
    },
    "./global": "./dist/orihon.global.js",
    "./orihon.css": "./dist/orihon.css",
    "./brand/*": "./assets/brand/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/orihon.css",
    "./dist/draw.css",
    "./assets/brand/tokens/orihon-tokens.css",
    "./dist/webgpu-entry.js",
    "./dist/layers/mlt.js",
    "./dist/layers/mvt-wasm.js",
    "./dist/mvt-entry.js",
    "./src/webgpu-entry.ts",
    "./src/layers/mlt.ts",
    "./src/layers/mvt-wasm.ts",
    "./src/mvt-entry.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-browser.mjs",
    "pretest": "npm run build",
    "test": "node scripts/run-unit-tests.mjs",
    "test:browser": "node test/browser-smoke.mjs && node test/tile-gpu-browser.mjs && node test/geojson-async-browser.mjs && node test/heat-browser.mjs && node test/export-png-browser.mjs && node test/popup-geometry-browser.mjs && node test/p1-browser.mjs && node test/object-manager-speed-browser.mjs",
    "test:server": "node scripts/browser-test-server.mjs",
    "test:e2e": "playwright test",
    "test:fuzz": "node --test test/coordinate-fuzz.test.js",
    "test:leaks": "node --expose-gc --test test/lifecycle-leak.test.js",
    "test:plugin": "tsc -p tsconfig.plugin-template.json",
    "fixtures": "node scripts/generate-test-fixtures.mjs",
    "size": "node scripts/check-size.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/types/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run size && npm run docs:check",
    "dist": "npm run build && node scripts/pack-dist.mjs",
    "prepack": "npm run build && node scripts/strip-publish-maps.mjs",
    "prepublishOnly": "npm run check",
    "docs:build": "node scripts/build-developer-guide.mjs",
    "docs:check": "node scripts/check-developer-guide.mjs",
    "demo:docs": "npm run build && npm run docs:build && node scripts/developer-guide-server.mjs",
    "demo:bench": "npm run build && npx --yes serve . -p 4176",
    "demo:heat-bench": "npm run build && npx --yes serve . -p 4178",
    "bench:object-manager": "npm run build && node scripts/bench-object-manager-scene.mjs",
    "demo:showcase": "npx --yes serve . -p 4177",
    "demo:planetary": "npx --yes serve examples/planetary-demo -p 4174",
    "demo:aircraft": "node examples/aircraft-radar-proxy/server.mjs",
    "demo:rzd": "node examples/rzd-train-122-tracker/server.mjs",
    "demo:navigation": "npx --yes serve . -p 8791",
    "demo:studio": "node _local/studio/server.mjs",
    "embed:examples": "node scripts/embed-examples.mjs",
    "bench:p0": "npm run build && node --expose-gc scripts/bench-p0-webgl.mjs"
  },
  "keywords": [
    "map",
    "gis",
    "tiles",
    "web-mercator",
    "open-source",
    "apache",
    "orihon"
  ],
  "author": "whahe",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "assets/brand",
    "docs/*.md",
    "docs/developer-guide/README.md",
    "LICENSE",
    "LICENSE-NOTICE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "terser": "^5.50.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whahedev/orihon.git"
  },
  "bugs": {
    "url": "https://github.com/whahedev/orihon/issues"
  },
  "homepage": "https://github.com/whahedev/orihon#readme"
}
